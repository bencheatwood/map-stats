{
  "name": "map-stats",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*.tsx",
    "#ui/*": "./src/components/ui/*.tsx",
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build": "vp build",
    "version": "pn i --lockfile-only && git add .",
    "postversion": "git push --follow-tags",
    "patch": "pn version patch -no-git-checks -m ",
    "minor": "pn version minor -no-git-checks -m ",
    "major": "pn version major -no-git-checks -m ",
    "prepare": "vp config",
    "up": "pn self-update && vp up -L",
    "predeploy": "vp build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "oxc-transform-react": "^0.151.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@12.6.0"
}
