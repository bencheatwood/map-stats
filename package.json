{
  "name": "map-stats",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*.tsx",
    "#ui/*": "./src/components/ui/*.tsx",
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build": "vp build",
    "version": "pn i --lockfile-only && git add .",
    "postversion": "git push --follow-tags",
    "patch": "pn version patch -no-git-checks -m ",
    "minor": "pn version minor -no-git-checks -m ",
    "major": "pn version major -no-git-checks -m ",
    "prepare": "vp config",
    "up": "pn self-update && vp up -L",
    "predeploy": "vp build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "gh-pages": "^6.3.0",
    "oxc-transform": "^0.144.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@11.22.0"
}
